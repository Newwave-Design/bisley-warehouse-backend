# Warehouse Management System
# Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/warehouse_db

# Medusa Integration
MEDUSA_API_BASE_URL=https://bisley-shop.medusajs.app
MEDUSA_API_KEY=your_medusa_admin_api_key

# JWT/Auth
JWT_SECRET=your_jwt_secret_change_in_production
JWT_ALGORITHM=HS256

# Genero Integration (Future)
GENERO_API_BASE_URL=https://genero.example.com
GENERO_API_KEY=your_genero_api_key

# Barcode Configuration
BARCODE_BEEP_ON_SCAN=true
BARCODE_TIMEOUT_MS=500

# Warehouse Configuration
DEFAULT_WAREHOUSE_LOCATION_PREFIX=BAY
