# Warehouse Management System
# Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/warehouse_db

# Medusa Integration
MEDUSA_API_BASE_URL=https://bisley-shop.medusajs.app
MEDUSA_API_KEY=your_medusa_admin_api_key

# JWT/Auth
JWT_SECRET=your_jwt_secret_change_in_production
JWT_ALGORITHM=HS256

# Genero Integration (Future)
GENERO_API_BASE_URL=https://genero.example.com
GENERO_API_KEY=your_genero_api_key

# Barcode Configuration
BARCODE_BEEP_ON_SCAN=true
BARCODE_TIMEOUT_MS=500

# Warehouse Configuration
DEFAULT_WAREHOUSE_LOCATION_PREFIX=BAY

# Genero Integration (Bisley New Wave API)
GENERO_API_URL=https://your-bisley-nw-endpoint.com/api/orders
GENERO_ACCOUNT_NO=NW123

# Medusa Webhook (order.placed ? auto-create pick list)
MEDUSA_WEBHOOK_SECRET=your_webhook_secret_here

# UPS Shipping Integration
UPS_CLIENT_ID=your_ups_client_id
UPS_CLIENT_SECRET=your_ups_client_secret
UPS_ACCOUNT_NUMBER=2761GR
UPS_ENVIRONMENT=test
UPS_SHIP_API_VERSION=v2403
UPS_SHIPPER_NAME=Ovara Products Ltd
UPS_SHIPPER_ATTENTION_NAME=Matthew Clark
UPS_SHIPPER_PHONE=+447825355231
UPS_SHIPPER_EMAIL=info@ovara.co.uk
UPS_SHIPPER_ADDRESS_1=Unit 1, The Old Police Station
UPS_SHIPPER_ADDRESS_2=Baker Street
UPS_SHIPPER_CITY=Abergavenny
UPS_SHIPPER_POSTAL_CODE=NP75BB
UPS_SHIPPER_COUNTRY_CODE=GB
UPS_SHIPPER_STATE_PROVINCE_CODE=
